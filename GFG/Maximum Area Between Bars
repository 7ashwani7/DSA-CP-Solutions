class Solution {
  public:
    int maxArea(vector<int> &height) {
        // code here
        int mx = 0;
        int n = height.size();
        int i=0, j = n-1;
        while(i<j){
            int h = min(height[i],height[j]);
            int b = j-i-1;
            mx = max(mx, h*b);
            if(height[i]<height[j]) i++;
            else j--;
        }
        return mx;
    }
};